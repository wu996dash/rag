# viki_rag 环境变量样例 —— 复制为 .env 并填真实值（.env 禁止进 git）
# 决策编号 D1-D7 见 DECISIONS.md

# --- LLM 通道（D1）：OpenAI 兼容协议，默认通义 Qwen-Plus ---
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 密钥读取规则：优先 LLM_API_KEY；未设置则回落系统环境变量 DASHSCOPE_API_KEY
# （本机已有 DASHSCOPE_API_KEY，实测 qwen-plus 返回 200；不要把明文密钥复制进 .env）
LLM_API_KEY=

# --- Milvus 向量库（D3）：本机已运行实例，gRPC 端口 ---
MILVUS_URI=http://127.0.0.1:19531

# --- Embedding / 重排运行环境（D2/D4）：cuda 或 cpu，OOM 时自动降级 ---
EMBED_DEVICE=cuda

# --- 本地模型权重路径（D2/D4）：复用本机已有下载，勿重新下载 ---
EMBED_MODEL_PATH=E:\edurag\Itcast_qa_system\rag_qa\models\bge-m3
RERANKER_PATH=E:\edurag\Itcast_qa_system\rag_qa\models\bge-reranker-v2-m3